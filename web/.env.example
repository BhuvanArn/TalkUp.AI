# Web (Vite) environment variables.
# Copy to `web/.env` and fill in real values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to client code; keep secrets out.

# --- Backend API ---
# Dev API base URL (falls back to http://localhost:3000 if unset).
VITE_BASE_URL=http://localhost:8080
# Production API base URL (falls back to https://api.talkupai.online if unset).
VITE_BASE_URL_PRODUCTION=https://talk-up-ai.up.railway.app

# --- Dev server ---
# Port the Vite dev server listens on (defaults to 8080 if unset).
VITE_PORT=8081
# Frontend origin, used by some flows for redirects.
FRONTEND_URL=http://localhost:8081

# --- WebSocket ---
# Shared key sent when opening the simulation WebSocket. Get the real value
# from a teammate or the deployment config; do not commit a real key.
VITE_WEBSOCKET_KEY=changeme

# --- Debug (optional) ---
# Set to 'true' to render the WebSocket debug panel in simulations (off in prod).
# VITE_SHOW_WS_DEBUG=true

# --- Docs (optional) ---
# Public documentation base URL (defaults to https://talkupai.online if unset).
# VITE_DOCUMENTATION_URL=https://talkupai.online

# --- Recruiter avatar (optional) ---
# Same-origin relative path to the recruiter GLB avatar model.
# Falls back to the bundled asset if unset. Must be a same-origin path.
# VITE_RECRUITER_AVATAR_URL=/avatars/recruiter-professional.glb
# Same-origin relative path to the recruiter office background image.
# Falls back to the bundled asset if unset. Must be a same-origin path.
# VITE_RECRUITER_OFFICE_BACKGROUND_URL=/backgrounds/recruiter-office.jpg

# --- Vercel (auto-provided in production/preview; leave unset locally) ---
# VITE_VERCEL_ENV=development|preview|production
# VITE_VERCEL_GIT_COMMIT_REF=branch-name
# VITE_VERCEL_GIT_PULL_REQUEST_ID=123

{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/mail/assets/**/*",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  },
  "exclude": ["test", "**/*spec.ts", "**/*test.ts", "src/test"]
}

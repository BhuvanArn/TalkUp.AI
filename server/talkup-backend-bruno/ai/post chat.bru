meta {
  name: post chat
  type: http
  seq: 6
}

post {
  url: {{host}}/ai/chat
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "message": "Which of these roadmap topics should I prioritise?",
    "history": [
      {
        "role": "user",
        "content": "Hi, I have an interview tomorrow."
      },
      {
        "role": "assistant",
        "content": "Great! What role are you preparing for?"
      }
    ],
    "context": {
      "surface": "roadmap",
      "applicationId": "019ac5a6-ada7-7a96-9a38-23819f37ab90"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

# Public URL of the web app (no trailing slash). Used in invitation emails for verify-email links.
FRONTEND_URL=http://localhost:5173

# CORS: must include PATCH if you override (password-update, partial updates). Default in main.ts is GET,PUT,PATCH,POST,DELETE.
# CORS_ORIGIN=http://localhost:8081
# CORS_METHODS=GET,POST,PUT,PATCH,DELETE
